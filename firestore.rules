rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /worldNotes/{noteId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 18
        && request.resource.data.villageId is string
        && request.resource.data.villageId.size() >= 1
        && request.resource.data.villageId.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500;

      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 18
        && request.resource.data.villageId == resource.data.villageId
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500;

      // Authors may remove their own published notes; founder/admin moderation may remove any note.
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || request.auth.token.admin == true);
    }

    match /worldNoteReports/{reportId} {
      // Any authenticated player may report a published note. Reports are append-only for players.
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.noteId is string
        && request.resource.data.villageId is string
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() >= 1
        && request.resource.data.reporterName.size() <= 18
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 300;
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
